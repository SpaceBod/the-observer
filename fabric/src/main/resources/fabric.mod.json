{
	"schemaVersion": 1,
	"id": "spacebod_observer",
	"version": "${version}",
	"name": "The Observer",
	"description": "The AI newspaper for your Minecraft world: every week a language model on your own computer writes up what your world's players actually did, and the Pawstman delivers it to your door.",
	"authors": [
		"SpaceBod"
	],
	"contact": {
		"homepage": "https://github.com/SpaceBod/the-observer",
		"sources": "https://github.com/SpaceBod/the-observer",
		"issues": "https://github.com/SpaceBod/the-observer/issues"
	},
	"license": "MIT",
	"icon": "assets/spacebod_observer/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.spacebod.observer.fabric.ObserverFabric"
		],
		"client": [
			"dev.spacebod.observer.fabric.client.ObserverFabricClient"
		],
		"modmenu": [
			"dev.spacebod.observer.fabric.client.ObserverModMenu"
		]
	},
	"mixins": [
		"spacebod_observer.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "${minecraft_range}",
		"java": ">=25",
		"fabric-api": "*"
	}
}
